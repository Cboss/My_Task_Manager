{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overseer",
  "version": "0.3.0",
  "identifier": "dev.overseer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Overseer",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
