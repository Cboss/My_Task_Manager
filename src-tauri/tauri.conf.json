{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overseer",
  "version": "0.4.0",
  "identifier": "dev.overseer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Overseer",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MkM3RDI1NTc2QTYzQTMKUldTalkycFhKWDBzVk9DeEVvNnhRd0t0c0tYcFkyT1hLWk43QUVtNWJRU2poczVUZ1ZvL2tQNHgK",
      "endpoints": [
        "https://github.com/Cboss/My_Task_Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
